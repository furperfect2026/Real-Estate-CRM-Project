# ─── Database ───────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://propforce:propforce_dev_2024@localhost:5432/propforce
DATABASE_URL_SYNC=postgresql://propforce:propforce_dev_2024@localhost:5432/propforce

# ─── Redis ──────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── JWT ────────────────────────────────────────────────
JWT_SECRET_KEY=change-this-to-a-random-64-char-secret-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Application ───────────────────────────────────────
APP_NAME=PropForce
APP_ENV=development
DEBUG=true
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000

# ─── Resend (Email) ────────────────────────────────────
RESEND_API_KEY=re_your_api_key_here

# ─── Google Gemini (AI — Phase 11) ─────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ─── S3-Compatible Storage ─────────────────────────────
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=propforce
S3_REGION=ap-south-1

# ─── Frontend ──────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=PropForce
